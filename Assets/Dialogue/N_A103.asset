  dialogueLines:
  - speakerName: "\u5C0F\u526A"
    content: "\u526A\u5934\u53D1\u5F88\u7B80\u5355\uFF0C\u4E0D\u6765\u7406\u53D1\u5E97\u81EA\u5DF1\u526A\u4E5F\u884C\uFF0C\u4F46\u526A\u5F97\u597D\u770B\u5F88\u96BE"
  - speakerName: "\u5C0F\u526A"
    content: "\u526A\u4E00\u5200\u5C31\u4F1A\u6389\u843D\u5F88\u591A\u788E\u53D1\uFF0C\u6321\u4F4F\u4F60\u7684\u773C\u775B\uFF0C\u628A\u5934\u53D1\u526A\u574F"
  - speakerName: "\u5C0F\u526A"
