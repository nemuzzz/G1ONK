.victory-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.content-container {
    width: 800px;
    background-color: rgb(41, 41, 41);
    border-radius: 20px;
    padding: 20px;
    align-items: center;
}

.result-text {
    font-size: 48px;
    color: rgb(255, 215, 0);
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.stats-container {
    width: 100%;
    margin-bottom: 30px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.stat-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.stat-value {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.rewards-container {
    width: 100%;
    margin-bottom: 30px;
}

.rewards-title {
    font-size: 24px;
    color: rgb(255, 215, 0);
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.coins-container {
    flex-direction: row;
    justify-content: center;
}

.coin {
    width: 64px;
    height: 64px;
    margin: 0 10px;
}

.leaderboard-container {
    width: 100%;
    margin-bottom: 20px;
}

.leaderboard-title {
    font-size: 28px;
    color: rgb(255, 215, 0);
    margin-bottom: 10px;
    -unity-font-style: bold;
    align-self: center;
}

.leaderboard-scroll {
    height: 250px;
    width: 100%;
    background-color: rgba(30, 30, 30, 0.5);
    border-radius: 10px;
}

.leaderboard-content {
    width: 100%;
}

.leaderboard-row {
    flex-direction: row;
    width: 100%;
    height: 40px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    align-items: center;
}

.header-row {
    background-color: rgba(60, 60, 60, 0.8);
    height: 50px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.header-cell {
    font-size: 18px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex: 1;
    padding: 5px;
}

.score-cell {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex: 1;
    padding: 5px;
}

.level-icon {
    width: 105px;
    height: 50px;
    align-self: center;
}

.health-icons-container {
    flex-direction: row;
    justify-content: center;
    width: 25px;
    height: 25px;
    align-self: center;
    margin-top: 0;
}

.current-score-container {
    width: 100%;
    margin-top: 20px;
    margin-bottom: 20px;
    background-color: rgba(60, 60, 60, 0.5);
    border-radius: 10px;
    padding: 10px;
}

.current-score-title {
    font-size: 22px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    margin-bottom: 10px;
    align-self: center;
}

.current-score-row {
    background-color: rgba(80, 80, 80, 0.5);
    border-radius: 5px;
    height: 50px;
}

.name-input-container {
    flex: 1;
    padding: 5px;
}

.player-name-input {
    width: 100%;
    height: 38px;
    background-color: rgb(255, 255, 255);
    border-radius: 5px;
    color: rgb(0, 0, 0);
    font-size: 16px;
}

.submit-button {
    margin-top: 10px;
    align-self: center;
    background-color: rgb(76, 175, 80);
}

.button {
    width: 200px;
    height: 60px;
    font-size: 24px;
    background-color: rgb(59, 153, 252);
    color: white;
    border-radius: 10px;
    transition: all 0.2s;
}

.button:hover {
    background-color: rgb(41, 128, 219);
    scale: 1.05;
}

.button:active {
    background-color: rgb(28, 100, 175);
    scale: 0.95;
}

.leaderboard-item {
    background-color: rgba(50, 50, 50, 0.5);
}

.leaderboard-item:hover {
    background-color: rgba(70, 70, 70, 0.8);
}

.rank-1 {
    background-color: rgba(255, 215, 0, 0.3);
}

.rank-2 {
    background-color: rgba(192, 192, 192, 0.3);
}

.rank-3 {
    background-color: rgba(205, 127, 50, 0.3);
}
