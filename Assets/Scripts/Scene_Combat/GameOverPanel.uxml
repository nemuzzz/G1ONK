<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="GameOverPanel" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.8); align-items: center; justify-content: center; flex-direction: column; top: -1px; left: 0; right: 0; bottom: 2px;">
        <ui:Label text="游戏结束" name="ResultText" style="font-size: 48px; color: rgb(255, 255, 255); margin-bottom: 20px; -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial;" />
        <ui:Button text="重试" name="RetryButton" style="width: 200px; height: 60px; font-size: 24px; -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; background-color: rgb(156, 137, 92); color: white; border-radius: 10px; margin-bottom: 10px;" />
        <ui:Button text="返回世界" name="ReturnButton" style="width: 200px; height: 60px; font-size: 24px; -unity-text-align: middle-center; white-space: nowrap; -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; background-color: rgb(156, 137, 92); color: white; border-radius: 10px;" />
    </ui:VisualElement>
</ui:UXML>
