<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Scene_Combat/VictoryPanel.uss?fileID=7433441132597879392&amp;guid=686350470b2b74746a1d5d0fe21e2e89&amp;type=3#VictoryPanel" />
    <ui:VisualElement name="VictoryPanel" class="victory-panel" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.8); align-items: center; justify-content: center; top: 0; left: 0; right: 0; bottom: 0; color: rgb(153, 128, 79);">
        <ui:VisualElement name="LeaderboardHeader" class="leaderboard-row header-row" style="background-color: rgb(155, 130, 82); height: 107px; width: 835px; align-self: auto; justify-content: flex-end; border-top-left-radius: 20px; border-top-right-radius: 20px; border-left-color: rgb(243, 239, 229); border-right-color: rgb(243, 239, 229); border-top-color: rgb(243, 239, 229); border-bottom-color: rgb(243, 239, 229); border-left-width: 8px; border-right-width: 8px; border-top-width: 8px; border-bottom-width: 0;">
            <ui:Label text="你成功了！在榜上留名吧" name="ResultText" class="result-text" style="font-size: 47px; color: rgb(239, 228, 205); margin-bottom: 20px; -unity-font-style: normal; -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(239, 228, 205); text-shadow: 0 0 50px rgb(176, 156, 120); white-space: nowrap; -unity-text-align: middle-center; height: 167px; width: 826px; justify-content: flex-end; align-items: center;" />
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" class="content-container" style="width: 835px; background-color: rgb(239, 228, 205); border-radius: 20px; padding: 20px; align-items: center; -unity-text-outline-color: rgba(0, 0, 0, 0); color: rgb(154, 130, 81); border-left-color: rgb(242, 238, 228); border-right-color: rgb(242, 238, 228); border-top-color: rgb(242, 238, 228); border-bottom-color: rgb(242, 238, 228); border-left-width: 8px; border-right-width: 8px; border-top-width: 0; border-bottom-width: 8px; height: 666px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; border-top-left-radius: 0; border-top-right-radius: 0;">
            <ui:VisualElement name="LeaderboardContainer" class="leaderboard-container" style="-unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial;">
                <ui:Label text="排行榜" name="LeaderboardTitle" class="leaderboard-title" style="color: rgb(150, 125, 75); -unity-background-image-tint-color: rgb(156, 132, 84); -unity-font-style: bold; text-shadow: 0 0 0 rgb(0, 0, 0); -unity-text-outline-color: rgb(239, 228, 205); -unity-text-outline-width: 0; letter-spacing: 0; font-size: 35px;" />
                <ui:VisualElement name="LeaderboardHeader" class="leaderboard-row header-row" style="background-color: rgba(155, 130, 82, 0.8);">
                    <ui:Label text="排名" name="RankHeader" class="header-cell" style="color: rgb(242, 238, 228);" />
                    <ui:Label text="玩家名称" name="NameHeader" class="header-cell" style="color: rgb(242, 238, 228); -unity-font-style: bold; -unity-text-outline-color: rgb(171, 149, 106); -unity-text-outline-width: 0;" />
                    <ui:Label text="关卡" name="LevelHeader" class="header-cell" style="color: rgb(242, 238, 228); -unity-font-style: bold;" />
                    <ui:Label text="子弹数" name="BulletsHeader" class="header-cell" style="color: rgb(242, 238, 228); -unity-font-style: bold;" />
                    <ui:Label text="错误数" name="ErrorsHeader" class="header-cell" style="color: rgb(242, 238, 228); -unity-font-style: bold;" />
                    <ui:Label text="生命" name="HealthHeader" class="header-cell" style="color: rgb(242, 238, 228);" />
                    <ui:Label text="总分" name="ScoreHeader" class="header-cell" style="color: rgb(242, 238, 228);" />
                </ui:VisualElement>
                <ui:ScrollView name="LeaderboardScroll" class="leaderboard-scroll" style="color: rgb(238, 228, 204); background-color: rgb(194, 177, 132); border-top-left-radius: 0; border-top-right-radius: 0;">
                    <ui:VisualElement name="LeaderboardContent" class="leaderboard-content" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="CurrentScoreContainer" class="current-score-container" style="background-color: rgb(176, 156, 120); height: 190px; width: 791px;">
                <ui:Label text="本局成绩" name="CurrentScoreTitle" class="current-score-title" style="color: rgb(242, 238, 228); -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; -unity-font-style: bold; text-shadow: 0 0 0 rgb(79, 54, 33); -unity-text-outline-color: rgb(176, 156, 120); -unity-text-outline-width: 0;" />
                <ui:VisualElement name="CurrentScoreRow" class="leaderboard-row current-score-row" style="background-color: rgb(194, 177, 132); height: 50px; width: 778px; align-items: center; justify-content: space-between; align-self: center;">
                    <ui:Label text="-" name="CurrentRank" class="score-cell" style="color: rgb(255, 255, 255); -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; -unity-font-style: bold;" />
                    <ui:VisualElement name="NameInputContainer" class="name-input-container">
                        <ui:TextField name="PlayerNameInput" class="player-name-input" style="-unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CurrentLevelIcon" class="score-cell level-icon" />
                    <ui:Label text="0" name="CurrentBullets" class="score-cell" style="-unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; font-size: 23px;" />
                    <ui:Label text="0" name="CurrentErrors" class="score-cell" style="-unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; font-size: 23px;" />
                    <ui:VisualElement name="CurrentHealthIcons" class="score-cell health-icons-container" style="width: 27px; height: 27px;" />
                    <ui:Label text="0" name="CurrentScore" class="score-cell" style="-unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; font-size: 23px;" />
                </ui:VisualElement>
                <ui:Button text="提交成绩" name="SubmitScoreButton" class="button submit-button" style="background-color: rgb(150, 126, 75); -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; color: rgb(242, 238, 228); text-shadow: 0 0 50px rgb(0, 0, 0); height: 44px; width: 137px; -unity-text-align: middle-center;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-around; width: 100%; margin-top: 20px;">
                <ui:Button text="返回世界" name="ReturnButton" class="button" style="width: 200px; height: 60px; font-size: 24px; background-color: rgb(150, 126, 75); color: rgb(242, 238, 228); border-radius: 10px; -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; text-shadow: 0 0 50px rgb(0, 0, 0);" />
                <ui:Button text="重试" name="RetryButton" class="button" style="width: 200px; height: 60px; font-size: 24px; background-color: rgb(150, 126, 75); color: rgb(242, 238, 228); border-radius: 10px; -unity-font: url(&apos;project://database/Assets/Sprites/Text/SanJiCuYuanJianTi-2.ttf?fileID=12800000&amp;guid=147360132518d47479200895fd432d4a&amp;type=3#SanJiCuYuanJianTi-2&apos;); -unity-font-definition: initial; -unity-font-style: normal; -unity-text-outline-width: 0; text-shadow: 0 0 100px rgb(14, 10, 0); -unity-text-outline-color: rgb(150, 126, 75); word-spacing: 0; -unity-paragraph-spacing: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
